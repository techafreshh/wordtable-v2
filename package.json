  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.0",
    "gsap": "^3.12.5",
    "tsx": "^4.16.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
