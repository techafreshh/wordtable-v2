{
  "name": "wordtable-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx server/src/ws.ts\"",
    "build": "node scripts/clean-dist.mjs && tsc -b && vite build && vite build --config vite.server.config.ts",
    "clean": "node scripts/clean-dist.mjs",
    "check-bundle": "node scripts/check-bundle.mjs",
    "serve": "node dist/server.js",
    "preview": "vite preview",
    "server": "tsx server/src/ws.ts",
    "server:build": "vite build --config vite.server.config.ts",
    "soak": "tsx tests/soak.ts",
    "test": "vitest run --root .",
    "test:watch": "vitest",
    "serve:e2e": "tsx server/src/ws.ts --port 4101",
    "test:e2e": "npm run build && WORDTABLE_DEBUG=1 tsx tests/e2e/ws-probe.mts && npx playwright test",
    "typecheck": "tsc -b",
    "lint": "tsc -b --noEmit"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "three": "^0.170.0",
    "ws": "^8.17.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.0",
    "concurrently": "^10.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
